import numpy as np
import matplotlib.pyplot as plt
from matplotlib.collections import LineCollection

segments = np.array([np.array([[0, 0],[0,1]])])
max_segments = 12
reduction = .6

def branch(point, length, direction, depth):
    global reduction
    global segments
    global max_segments

    depth += 1
    length = length*reduction
    direction = not direction

    if(depth > max_segments):
        return
    elif(direction):
        segments = np.append(segments, [np.array([[point[0]-length, point[1]],[point[0]+length, point[1]]])], axis=0)
        branch([point[0] + length, point[1]], length, direction, depth)
        branch([point[0] - length, point[1]], length, direction, depth)
    else:
        segments = np.append(segments, [np.array([[point[0], point[1]-length],[point[0], point[1]+length]])],axis=0)
        branch([point[0], point[1] + length], length, direction, depth)
        branch([point[0], point[1] - length], length, direction, depth)

def update_plot(new_reduction):
    global segments
    global reduction

    reduction = new_reduction
    print("here")
    segments = np.array([np.array([[0, 0],[0,1]])])

    branch([0,1], 1, 0, 0)
    ax.clear()
    lc = LineCollection(segments)
    ax.add_collection(lc)
    ax.autoscale()
    fig.canvas.draw_idle()

fig, ax = plt.subplots()
ax.set_xlabel("x")
ax.set_ylabel("y")
ax.set_title("Plot of Fractal in 2D Cartesian Space")

plt.subplots_adjust(bottom=0.2)  # Make room for sliders

ax_reduction = plt.axes([0.18, 0.07, 0.65, 0.03])
reduction_slider = plt.Slider(ax_reduction, 'reduction', 0.0, 1.0, valinit=reduction,valstep=0.01)

update_plot(reduction)

reduction_slider.on_changed(lambda val: update_plot(val))

plt.show()

        